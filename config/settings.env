# == Configuration ==
# Edit these values or override with CLI flags

# Ollama model to load
# You can use any GGUF model from Hugging Face:
#   hf.co/bartowski/Llama-3.2-1B-Instruct-GGUF
#   hf.co/user/repo:Q8_0          (specify quantization tag)
MODEL_NAME=qwen3.5:9b

# Max concurrent requests (Kaggle T4 GPUs: 1-2 recommended)
MAX_CONCURRENT=2

# Context window (tokens)
NUM_CTX=16384

# Max tokens to generate
NUM_PREDICT=16384

# Batch size for decoding
NUM_BATCH=500

# Flash attention (True/False)
FLASH_ATTN=True

# Retry on empty stream (True = retry up to 2 times, False = return error immediately)
# WARNING: Retrying re-sends the full conversation — model regenerates from start
RETRY_ON_EMPTY=False

# Assign all GPUs (-1 = all)
NUM_GPU=-1

# Keep model loaded in RAM ("60m" = 60min, "-1" = forever)
KEEP_ALIVE=60m

# FastAPI port
PORT=8000

# Debug mode (True = verbose logging, False = minimal)
DEBUG_MODE=True

# Show request log in terminal (True = show every request, False = silent)
VERBOSE_LOG=False

# == TTS Settings ==
# Enable or disable text-to-speech endpoint
TTS_ENABLED=true

# Default TTS engine: omnivoice (600+ langs) | inflect (English only, tiny)
TTS_DEFAULT_ENGINE=omnivoice

# OmniVoice device: cuda (GPU) | cpu
TTS_OMNIVOICE_DEVICE=cuda

# Inflect variant: nano (~16MB, faster) | micro (~38MB, better quality)
TTS_INFLECT_VARIANT=nano

# Max characters per TTS request (prevent abuse / OOM)
TTS_MAX_CHARS=5000

# === OmniVoice Params (default values, overrideable per-request) ===
# Voice design string — gender, age, pitch, accent, emotion
TTS_OMNI_INSTRUCT="male, young adult, clear"

# Diffusion steps: 8 (fastest) → 32 (highest quality)
TTS_OMNI_NUM_STEP=16

# Playback speed: 0.25 (slow) → 4.0 (fast)
TTS_OMNI_SPEED=1.0

# Classifier-free guidance: higher = more faithful to instruct, lower = more natural
TTS_OMNI_GUIDANCE_SCALE=2.0

# === Inflect Params (default values, overrideable per-request) ===
# Playback speed: 0.5 (slow) → 2.0 (fast)
TTS_INFLECT_SPEED=1.0

# Prosody variation: 0.0 (robotic) → 1.0 (very expressive)
TTS_INFLECT_VARIATION=0.667

# Random seed for reproducible output
TTS_INFLECT_SEED=7

# == Garbage Collection ==
# Seconds before an idle model is auto-evicted (0 = never)
GC_IDLE_TIMEOUT=600

# How often GC checks for idle models (seconds)
GC_SWEEP_INTERVAL=60

# == File paths (override if needed) ==
SERVER_LOG_FILE=/tmp/gateway-server.log
TUNNEL_LOG_FILE=/tmp/cloudflared.log
URL_FILE=/tmp/kaggle-ollama-url.txt
OLLAMA_PULL_LOG=/tmp/ollama-pull.log
REQUEST_LOG_FILE=/tmp/gateway-requests.log
